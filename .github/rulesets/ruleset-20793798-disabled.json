      "integration_id": 15368
     },
     {
      "context": "npm audit (frontend deps)",
      "integration_id": 15368
     },
     {
      "context": "pip-audit (backend deps)",
      "integration_id": 15368
     },
     {
      "context": "gitleaks (secret scan)",
      "integration_id": 15368
     },
