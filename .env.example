# Job360 Configuration
# Copy to .env and fill in your values.
# All vars are optional unless flagged REQUIRED IN PROD.

# === Required in production ===
# itsdangerous signing secret for session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Fernet key for encrypting channel credentials. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_ENCRYPTION_KEY=
# Postgres password used by docker-compose.prod.yml (M10). It has NO default
# there on purpose — compose REFUSES to start without it rather than fall back
# to a committed password. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# === Database (REQUIRED IN PROD) ===
# PostgreSQL DSN (psycopg3). The backend is Postgres-only — SQLite is gone.
# Dev default (docker-compose.dev.yml, host port 5433) is used if unset.
# Validated as required when APP_ENV=production or RAILWAY_ENVIRONMENT is set.
DATABASE_URL=postgresql://job360:job360dev@localhost:5433/job360

# === Runtime environment ===
# JOB360_ENV is DEAD — nothing in src/ reads it any more (only a comment at
# auth.py:120 records that it once did). The session-cookie `Secure` flag now
# gates on the SAME signal as HSTS/Sentry/CORS: middleware._is_production(),
# i.e. APP_ENV=production OR RAILWAY_ENVIRONMENT set. Railway injects
# RAILWAY_ENVIRONMENT automatically, so production cookies ARE Secure.
#
# This block previously told you the opposite — that cookies ship WITHOUT Secure
# unless you set JOB360_ENV=prod — and that stale instruction cost a session
# chasing a security hole that did not exist. Do not re-add it.
# Marks production for HSTS + required-env validation. Railway sets
# RAILWAY_ENVIRONMENT automatically; set APP_ENV=production elsewhere.
APP_ENV=
# CORS allow-list for the Next.js frontend. Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000
# Logging verbosity. DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
# Redis broker URL — only required when running the ARQ worker.
REDIS_URL=redis://localhost:6379

# === LLM providers (at least one required for CV parsing) ===
# OpenAI (paid) is the PRIMARY provider — reliable quota, deterministic, structured
# output. The free tiers below are fallbacks. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override the OpenAI model (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Google Gemini free tier (fallback) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras free tier — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# === Job board APIs (all optional — free sources work without any) ===
# Reed — https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# Adzuna — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch (via RapidAPI) — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Jooble — https://jooble.org/api/about
JOOBLE_API_KEY=
# SerpAPI (Google Jobs) — https://serpapi.com/users/sign_up
SERPAPI_KEY=
# Careerjet affiliate ID — https://www.careerjet.com/partners/
CAREERJET_AFFID=
# Findwork — https://findwork.dev/developers/
FINDWORK_API_KEY=
# DfE "Find an apprenticeship" Display Advert API v2 — free subscription key
# from https://developer.apprenticeships.education.gov.uk (UK apprenticeships)
DFE_APPRENTICESHIPS_API_KEY=

# === GitHub profile enrichment ===
# Optional personal access token — raises public API rate limit from 60 → 5000/hr.
# Create at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# === Email notifications ===
# Gmail SMTP + app password — https://myaccount.google.com/apppasswords
SMTP_EMAIL=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# === Scoring weights + gate thresholds (Pillar 2) ===
# Minimum title-component fraction for a job to pass the gate (0.0–1.0).
MIN_TITLE_GATE=0.15
# Minimum skill-component fraction for a job to pass the gate (0.0–1.0).
MIN_SKILL_GATE=0.15
# Dimension weights in the 7-dim scorer.
SALARY_WEIGHT=10
SENIORITY_WEIGHT=8
VISA_WEIGHT=6
WORKPLACE_WEIGHT=6
# Target salary range (GBP) — used for tiebreaker sorting + salary scoring.
TARGET_SALARY_MIN=40000
TARGET_SALARY_MAX=120000

# === Per-engine switches (independent on/off per scoring engine) ===
# Four scoring engines, each toggled separately so ANY combination can run
# (e.g. ENGINE1=true ENGINE3=true, ENGINE2=false ENGINE4=false).
#   ENGINE1 — keyword match (titles/skills/location/freshness)
#   ENGINE2 — dimensions (seniority/salary/visa/workplace); needs enrichment data
#   ENGINE3 — hybrid search (BM25 + vector + rerank); needs [semantic] extra + index
#   ENGINE4 — LLM judge (reads full profile + job, scores fit 0-100); needs LLM keys
# Each defaults to its legacy flag below, so leaving these unset keeps old behaviour.
ENGINE1_ENABLED=true
ENGINE2_ENABLED=false
ENGINE3_ENABLED=false
ENGINE4_ENABLED=false
#
# --- RECOMMENDED production config (eval-backed): the JUDGE-LED FUNNEL ---------
# Our trustworthy eval across 5 real CVs + 16 engine combos (4 metrics, gold
# graded by Opus + agreed by an independent judge) found, consistently on every
# field: E4 Judge >> E3 Hybrid > E2 Dims > E1 Keyword > BM25. So lead ranking
# with the judge; keyword/BM25 are recall, not rankers. See harness/eval/engine_eval_audit_log.md.
# To run the judge-led funnel, set:
#   ENGINE1_ENABLED=true   ENGINE2_ENABLED=true   ENGINE3_ENABLED=true   ENGINE4_ENABLED=true
# It stays AFFORDABLE because of the funnel + cache:
#   - the judge only scores the top MATCHER_MAX_JOBS (cheap engines shortlist first)
#   - verdicts are CACHED per (profile_version, job); re-judged only when the
#     profile changes (proven by tests/test_llm_matcher.py::test_matcher_stage_caches_verdict_no_rejudge)
# E3 also needs the [semantic] extra + a populated vector index; E2/E4 need LLM keys.

# === Feature flags (legacy gates — each still honoured; the ENGINE* switch above
# OR's with the matching flag here) ===
# Enable sentence-transformers + ChromaDB semantic retrieval (requires [semantic] extra).
SEMANTIC_ENABLED=false
# Enable LLM-based job enrichment pipeline.
ENRICHMENT_ENABLED=false
# Min match_score above which a job is enriched via LLM. Default 60.
ENRICHMENT_THRESHOLD=60
# Step-1 B12 — per-user cap on concurrent POST /search runs. Once a user
# has this many pending/running searches, further POST /search returns
# HTTP 429. Other users are unaffected.
MAX_CONCURRENT_SEARCHES_PER_USER=3

# === LLM judge (engine #4) ===
# Enable the LLM fit-judge. Off = pipeline is byte-identical to pre-matcher.
MATCHER_ENABLED=false
# Only jobs with keyword match_score >= this are judged (default 30).
MATCHER_THRESHOLD=30
# Max jobs per user per run sent to the judge (default 30).
MATCHER_MAX_JOBS=30

# === AI CV & cover-letter (tailored documents) ===
# Free-tier cap on tailored-document generations per user per month (paid LLM call each).
TAILOR_FREE_PER_MONTH=10
# Cost cap: max profile re-extractions per user per hour. Each one fans out
# to 4+ paid LLM calls over CV/LinkedIn/GitHub/about_me. 0 disables the cap.
PROFILE_EXTRACT_MAX_PER_HOUR=12

# === Auth hardening ===
# Brute-force login lockout: after N failed logins for one email within the
# window (seconds), /api/auth/login returns HTTP 429 until the burst ages out.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# === OAuth 2.1 for MCP clients (Claude.ai / ChatGPT connect via the browser) ===
# Redirect URIs a registering client may use (comma-separated; exact
# scheme/host/port, path equal or — entry ending in "/" — prefix). Default:
# the Claude.ai + ChatGPT callbacks. Add a new MCP client HERE, never in code.
OAUTH_REDIRECT_ALLOWLIST=
# 1 = also allow RFC 8252 loopback redirects (127.0.0.1 / ::1 / localhost, any
# port) for desktop clients. Keep 0 in prod.
OAUTH_ALLOW_LOOPBACK_REDIRECTS=0
# Token lifetimes (seconds): access token, and the ABSOLUTE life of a grant's
# refresh chain (counted from the grant, not the last refresh).
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Authorization-code life, and how long a pending consent request survives
# (long enough for the magic-link email round trip).
OAUTH_CODE_TTL_SECONDS=60
OAUTH_AUTHORIZE_TTL_SECONDS=1800
# A code/refresh token presented twice inside this window is a client retry;
# after it, the whole grant is revoked.
OAUTH_REUSE_GRACE_SECONDS=10
# Rate limits (429 over cap).
OAUTH_REGISTER_MAX_PER_HOUR=60
OAUTH_REGISTER_MAX_PER_HOUR_GLOBAL=600
OAUTH_AUTHORIZE_MAX_PER_MIN=60
OAUTH_TOKEN_FAIL_MAX_PER_MIN=30
OAUTH_BEARER_FAIL_MAX_PER_MIN=30
# Housekeeping: drop a client with no grant after N days; cap the client
# table; run the prune after 1-in-N /token calls.
OAUTH_CLIENT_PRUNE_DAYS=7
OAUTH_MAX_CLIENTS=10000
OAUTH_PRUNE_SAMPLE=20

# === Error tracking ===
# Sentry DSN (Phase 3). Empty = Sentry disabled.
SENTRY_DSN=

# === Source fetch ceilings (seconds) ===
SOURCE_FETCH_TIMEOUT=60
SOURCE_FETCH_TIMEOUT_ATS=240

# === Migrations (H6) ===
# Migrations apply inside the FastAPI process at boot. Set this to false ONLY
# once your deploy pipeline runs them as an explicit release step
# (`python -m migrations.runner up`) — otherwise the schema never gets created.
# Leaving it unset keeps the current, safe behaviour.
RUN_MIGRATIONS_ON_BOOT=true

# === Scraper overrides (advanced) ===
# 80000Hours uses the site's public Algolia keys by default — these work out of the box.
# Only override if the public keys rotate upstream.
EIGHTYKHOURS_ALGOLIA_APP_ID=
EIGHTYKHOURS_ALGOLIA_API_KEY=

# ---------------------------------------------------------------------------
# L5 — vars the backend reads that were missing from this file (added 2026-07-23).
# `python backend/scripts/check_env_example.py` enforces this list stays complete.
# ---------------------------------------------------------------------------

# Email delivery (Resend is the live path; SMTP_* are the generic fallback).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=login@job360.uk

# Auth: enforce email verification on gated routes (default on).
REQUIRE_EMAIL_VERIFICATION=true
# Trust the first X-Forwarded-For hop for the client IP (ONLY behind a trusted
# proxy — else the source IP is spoofable). Unset = don't trust XFF.
JOB360_TRUST_PROXY=

# Rate limiting: use a shared Redis backend so caps hold across replicas
# (default false = in-process only).
RATE_LIMIT_REDIS=false

# LLM tuning (CV parsing / matcher). Defaults shown.
LLM_TEMPERATURE=0
LLM_CALL_TIMEOUT_S=60
LLM_RATE_LIMIT_RETRIES=2
LLM_RATE_LIMIT_BASE_DELAY_S=2
LLM_RATE_LIMIT_MAX_WAIT_S=8
CEREBRAS_MODEL=gpt-oss-120b

# Auto-injected by Railway on every deployed service — used for prod detection
# (cookie Secure / HSTS / Sentry / the E2E-bypass guard). Do NOT set locally.
RAILWAY_ENVIRONMENT=

# ---------------------------------------------------------------------------
# The application spine (docs/plans/2026-09-04-application-spine/spec.md)
# ---------------------------------------------------------------------------

# R12/R13 — the legacy search UI + catalog crons, both default OFF. The
# mission (docs/product/VISION.md) is "the agent finds the job, Job360
# remembers" — Job360 never sources or ranks. Not security controls (the
# gated routes keep their normal auth either way).
SEARCH_UI_ENABLED=false
CATALOG_CRONS_ENABLED=false

# R7 — non-status event types an operator can add WITHOUT a migration
# (comma-separated). A STATUS event also needs an R4 mapping entry in
# src/services/applications/status.py, so it can never be env-added.
APPLICATION_EXTRA_EVENT_TYPES=

# S5 — input caps (defaults shown). Every breach is a 422/429 naming the
# field and the limit, never a silent drop/clip.
APPLICATION_EVENT_DETAIL_MAX_CHARS=2000
APPLICATION_EVENT_PAYLOAD_MAX_BYTES=8192
APPLICATION_EVENT_MAX_FUTURE_SECONDS=300
APPLICATION_ARTIFACT_MAX_CHARS=60000
APPLICATION_ARTIFACT_MAX_VERSIONS=200
APPLICATION_RECEIPT_ANSWERS_MAX=50
APPLICATION_RECEIPT_ANSWER_MAX_CHARS=2000
APPLICATION_RECEIPT_FIELDS_MAX_BYTES=8192
APPLICATION_FIT_REASONING_MAX_CHARS=4000

# S3 — how much of an OAuth client's attacker-supplied name `actor_for`
# keeps as `agent:<name>` authorship (C8: was hardcoded before).
APPLICATION_ACTOR_NAME_MAX_CHARS=60

# R9 — whats_new.
WHATS_NEW_DEFAULT_WINDOW_DAYS=7
WHATS_NEW_MAX_EVENTS=200

# R10/S8 — export_history bounds + per-user rate limit.
EXPORT_HISTORY_MAX_APPLICATIONS=500
EXPORT_HISTORY_MAX_BYTES=8388608
EXPORT_HISTORY_MAX_PER_HOUR=12
