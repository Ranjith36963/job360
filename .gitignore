# Python
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.env
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
*.log
data/
# ...EXCEPT the compiled UK gazetteer. It is checked in on purpose: the UK gate
# runs on every ingest and its tests must pass OFFLINE (hard rule #4), so the
# data cannot be a runtime download the way ESCO is. 745 KB, rebuilt only by
# `python backend/scripts/build_uk_gazetteer.py` — UK settlements do not churn.
# It now lives INSIDE the package (`backend/src/data/uk_gazetteer/`) because
# `pip install .` ships only `src*`; anywhere else and production runs without
# it, which is issue #260. `data/` above matches a directory of that name at
# ANY depth, so the exception has to name the new home too.
!backend/src/data/
!backend/src/data/uk_gazetteer/
!backend/src/data/uk_gazetteer/**
# ...and the job-signal vocabularies, for the same reason: the detectors run on
# every scored job and their tests must pass OFFLINE (hard rule #4). CI proved
# this the hard way — without the files committed, the detectors correctly
# degraded to UNKNOWN and 4 tests failed in CI while passing locally.
# MOVED 2026-08-13 from `backend/data/job_signals/` to inside the package, the
# same fix issue #260 applied to the gazetteer: the ARQ worker imports `src`
# from site-packages (arq/cli.py APPENDS cwd, so it loses to site-packages), and
# that copy had no sibling `data/`. Only package-data travels with the wheel.
!backend/src/data/job_signals/
!backend/src/data/job_signals/**
.secrets/

# Playwright MCP cache + ad-hoc test screenshots
.playwright-mcp/
test-*.png

# Claude Code embedded worktrees (gitlinks; tracked separately on their branches)
.claude/worktrees/

# Claude Code settings backups
.claude/settings.local.json.backup-*

# Claude Code schedule skill runtime lock
.claude/scheduled_tasks.lock

# Python build artifacts
*.egg-info/
# E2E verification artifacts: ignore everything under test-artifacts/ EXCEPT the
# two committed fixtures (README + sample CV). The old `test-artifacts/*.png`
# glob only caught top-level PNGs, letting nested screenshot dirs (design/,
# tailor/, verify-*/) accumulate untracked and risk a `git add -A` sweep.
test-artifacts/*
!test-artifacts/README.md
!test-artifacts/sample_cv.pdf
frontend/playwright-report/
# Personal/local Claude Code config — machine-specific (permissions, hooks).
# Stays on disk; should not be version-controlled (W2 review fix).
.claude/settings.local.json
User_info/
backend/data/experiment/

# Per-tree test-gate stamp (scripts/agent-gate.sh) - never committable
.claude/gate-stamp

# One-time step-verification receipts (transient, regenerated per run - never committable)
.claude/step-*-verified.txt

# Loop round lock - transient, never committable
docs/maintenance/.lock

# ── Repo-hygiene hardening (2026-07-26 audit) ────────────────────────────────
# mypy's own cache DBs. 27 MB of these were committed by accident in PR #92 —
# the two cache.db files were the largest tracked files in the whole repo.
.mypy_cache*/
backend/.mypy_cache*/

# Ad-hoc local tool output that lands at repo root (graphify codebase-graph, 5+ MB).
# Untracked but unignored is one `git add -A` away from entering history.
graphify-out/

# Claude settings backups. The pre-existing `backup-*` rule never matched: every
# backup actually written uses the `bak-before-*` shape.
.claude/settings.local.json.bak-*

# Playwright MCP scratch output (screenshots/snapshots from browser verification).
.playwright-mcp/

# Per-session CLAUDE.md drift proposals (Stop hook). Untracked by design: a tracked
# target would leave an uncommitted change in every one of the parallel worktrees
# and break the mandated clean-tree preflight. Collated into
# docs/maintenance/claude-md-proposals.md by a designated session, via PR.
docs/maintenance/inbox/
